<Window x:Class="SolidShowcase.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOLID Showcase · Лабораторна робота №1"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F5F3EE">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#18201F" />
        <SolidColorBrush x:Key="Muted" Color="#66706E" />
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="#D9DDD8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFF2EC" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E8734A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F9DED2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="ModuleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#BFC9C6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#253432" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" x:Key="InputBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,5,10,10" />
            <Setter Property="BorderBrush" Value="#D5DAD4" />
            <Setter Property="Background" Value="#FBFBF9" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="ComboBox" x:Key="InputCombo">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,5,10,10" />
            <Setter Property="BorderBrush" Value="#D5DAD4" />
            <Setter Property="Background" Value="#FBFBF9" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" MinWidth="470" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172321" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="42" Height="42" CornerRadius="12" Background="#E8734A" HorizontalAlignment="Left">
                        <TextBlock Text="S" FontSize="22" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="SOLID SHOWCASE" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,16,0,4" />
                    <TextBlock Text="Лабораторна робота №1" Foreground="#8FA09C" FontSize="12" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="ЗАВДАННЯ" Foreground="#70817D" FontSize="11"
                           FontWeight="Bold" Margin="0,44,0,10" />
                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource ModuleButton}" Tag="import" Click="Module_Click">
                        <StackPanel>
                            <TextBlock Text="01  Імпорт даних" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="CSV · JSON · валідація" Foreground="#82928E" FontSize="11" Margin="28,5,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleButton}" Tag="library" Click="Module_Click">
                        <StackPanel>
                            <TextBlock Text="02  Каталог бібліотеки" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Пошук · групування · CRUD" Foreground="#82928E" FontSize="11" Margin="28,5,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModuleButton}" Tag="fleet" Click="Module_Click">
                        <StackPanel>
                            <TextBlock Text="03  Автобаза" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Рейси · водії · ремонт" Foreground="#82928E" FontSize="11" Margin="28,5,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="S  O  L  I  D" Foreground="#E8734A" FontSize="13" FontWeight="Bold" />
                    <TextBlock Text="Натисніть дію — і подивіться, як архітектура працює крок за кроком."
                               Foreground="#82928E" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="38,30,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="ModuleEyebrow" Text="ЗАВДАННЯ 01" Foreground="#2C7A73" FontSize="12" FontWeight="Bold" />
                <TextBlock x:Name="ModuleTitle" Text="Імпорт даних" Foreground="{StaticResource Ink}"
                           FontSize="34" FontWeight="Bold" Margin="0,7,0,5" />
                <TextBlock x:Name="ModuleSubtitle" Text="CSV / JSON → валідація → репозиторій → звіт"
                           Foreground="{StaticResource Muted}" FontSize="14" />
            </StackPanel>
            <ItemsControl x:Name="ActionsList" Grid.Row="1" Margin="0,28,0,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Tag="{Binding Id}" Click="Action_Click"
                                Style="{StaticResource ActionButton}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2" Background="White" BorderBrush="#DFE2DC" BorderThickness="1"
                    CornerRadius="16" Padding="20" Margin="0,0,0,18" MaxHeight="345">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <Border Background="#F6EDCF" CornerRadius="8" Padding="9,5" DockPanel.Dock="Right">
                            <TextBlock Text="РУЧНИЙ РЕЖИМ" Foreground="#6F5A25" FontSize="9" FontWeight="Bold" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="ВЛАСНІ ДАНІ" Foreground="#2C7A73" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="ManualTitle" Text="Імпортуйте власний файл" FontSize="19"
                                       FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid x:Name="ImportForm" Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Формат" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" />
                            <ComboBox x:Name="ImportFormatCombo" Style="{StaticResource InputCombo}" SelectedIndex="0">
                                <ComboBoxItem Content="CSV" /><ComboBoxItem Content="JSON" />
                            </ComboBox>
                            <Button Content="Приклад" Style="{StaticResource ActionButton}" Click="FillImportSample_Click" />
                            <Button Content="Імпортувати" Style="{StaticResource ActionButton}" Click="ManualImport_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Вміст файла" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" />
                            <TextBox x:Name="ImportContentBox" Style="{StaticResource InputBox}" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="LibraryForm" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="Тип" /><ComboBox x:Name="LibraryTypeCombo" Style="{StaticResource InputCombo}" SelectedIndex="0"><ComboBoxItem Content="Книга" /><ComboBoxItem Content="Газета" /><ComboBoxItem Content="Альманах" /></ComboBox></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Назва" /><TextBox x:Name="LibraryTitleBox" Style="{StaticResource InputBox}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Видавництво" /><TextBox x:Name="LibraryPublisherBox" Style="{StaticResource InputBox}" /></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="Рік" /><TextBox x:Name="LibraryYearBox" Text="2026" Style="{StaticResource InputBox}" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Автор" /><TextBox x:Name="LibraryAuthorBox" Style="{StaticResource InputBox}" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Жанр" /><TextBox x:Name="LibraryGenreBox" Style="{StaticResource InputBox}" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Сторінки / № газети" /><TextBox x:Name="LibraryNumberBox" Text="100" Style="{StaticResource InputBox}" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3"><TextBlock Text="Дата" /><TextBox x:Name="LibraryDateBox" Text="2026-09-30" Style="{StaticResource InputBox}" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="4"><TextBlock Text="Колонки газети або твори альманаху" /><TextBox x:Name="LibraryDetailsBox" Style="{StaticResource InputBox}" /></StackPanel>
                            <WrapPanel Grid.Row="3" Grid.ColumnSpan="4">
                                <Button Content="Додати" Style="{StaticResource ActionButton}" Click="AddLibrary_Click" />
                                <Button Content="Завантажити вибране" Style="{StaticResource ActionButton}" Click="LoadLibrary_Click" />
                                <Button Content="Зберегти зміни" Style="{StaticResource ActionButton}" Click="UpdateLibrary_Click" />
                                <Button Content="Видалити" Style="{StaticResource ActionButton}" Click="DeleteLibrary_Click" />
                            </WrapPanel>
                            <Grid Grid.Row="4" Grid.ColumnSpan="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="LibrarySelectionCombo" DisplayMemberPath="Title" SelectedValuePath="Id" Style="{StaticResource InputCombo}" />
                                <ComboBox x:Name="SearchFieldCombo" Grid.Column="1" Style="{StaticResource InputCombo}" SelectedIndex="0"><ComboBoxItem Content="Назва" /><ComboBoxItem Content="Автор" /><ComboBoxItem Content="Видавництво" /><ComboBoxItem Content="Рік" /></ComboBox>
                                <TextBox x:Name="SearchQueryBox" Grid.Column="2" Style="{StaticResource InputBox}" />
                                <Button Grid.Column="3" Content="Знайти" Style="{StaticResource ActionButton}" Click="SearchLibrary_Click" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <TabControl x:Name="FleetForm" Grid.Row="1" Visibility="Collapsed" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Заявка на рейс">
                            <WrapPanel Margin="8">
                                <StackPanel Width="155"><TextBlock Text="Призначення" /><TextBox x:Name="DestinationBox" Style="{StaticResource InputBox}" /></StackPanel>
                                <StackPanel Width="155"><TextBlock Text="Тип вантажу" /><TextBox x:Name="CargoTypeBox" Style="{StaticResource InputBox}" /></StackPanel>
                                <StackPanel Width="110"><TextBlock Text="Вага, т" /><TextBox x:Name="CargoWeightBox" Text="1" Style="{StaticResource InputBox}" /></StackPanel>
                                <StackPanel Width="110"><TextBlock Text="Відстань" /><TextBox x:Name="DistanceBox" Text="100" Style="{StaticResource InputBox}" /></StackPanel>
                                <StackPanel Width="110"><TextBlock Text="Стаж" /><TextBox x:Name="RequiredExperienceBox" Text="1" Style="{StaticResource InputBox}" /></StackPanel>
                                <Button Content="Створити рейс" Style="{StaticResource ActionButton}" Click="DispatchCustom_Click" />
                            </WrapPanel>
                        </TabItem>
                        <TabItem Header="Новий водій">
                            <WrapPanel Margin="8">
                                <StackPanel Width="240"><TextBlock Text="Ім'я" /><TextBox x:Name="DriverNameBox" Style="{StaticResource InputBox}" /></StackPanel>
                                <StackPanel Width="140"><TextBlock Text="Стаж" /><TextBox x:Name="DriverExperienceBox" Text="1" Style="{StaticResource InputBox}" /></StackPanel>
                                <Button Content="Додати водія" Style="{StaticResource ActionButton}" Click="AddDriver_Click" />
                            </WrapPanel>
                        </TabItem>
                        <TabItem Header="Новий автомобіль">
                            <WrapPanel Margin="8">
                                <StackPanel Width="220"><TextBlock Text="Модель" /><TextBox x:Name="VehicleModelBox" Style="{StaticResource InputBox}" /></StackPanel>
                                <StackPanel Width="160"><TextBlock Text="Вантажопідйомність" /><TextBox x:Name="VehicleCapacityBox" Text="3.5" Style="{StaticResource InputBox}" /></StackPanel>
                                <StackPanel Width="140"><TextBlock Text="Складність" /><TextBox x:Name="VehicleDifficultyBox" Text="2" Style="{StaticResource InputBox}" /></StackPanel>
                                <Button Content="Додати автомобіль" Style="{StaticResource ActionButton}" Click="AddVehicle_Click" />
                            </WrapPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="White" BorderBrush="#E1E3DE" BorderThickness="1" CornerRadius="16" Padding="26" MinHeight="180">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Border Background="#EAF3F1" CornerRadius="8" Padding="10,5" DockPanel.Dock="Right">
                            <TextBlock x:Name="ResultStatus" Text="ГОТОВО" Foreground="#2C7A73" FontSize="11" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="РЕЗУЛЬТАТ" Foreground="#8A9290" FontWeight="Bold" FontSize="11" />
                    </DockPanel>
                    <TextBlock x:Name="ResultTitle" Grid.Row="1" Text="Data Import Pipeline" FontSize="23"
                               FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,16,0,14" TextWrapping="Wrap" />
                    <ListBox x:Name="ResultLines" Grid.Row="2" BorderThickness="0" Background="Transparent" IsHitTestVisible="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F7F4" CornerRadius="8" Margin="0,0,0,8" Padding="13,10">
                                    <TextBlock Text="{Binding}" Foreground="#38413F" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="#101817" Padding="26,30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="210" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Border x:Name="TraceBadge" Background="#E8734A" CornerRadius="14" Padding="10,5" DockPanel.Dock="Right">
                        <TextBlock x:Name="TracePrinciple" Text="SOLID" Foreground="White" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="ВИКОНАННЯ КОДУ" Foreground="#80908C" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Покрокова траса" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="TraceList" Grid.Row="1" Margin="0,20,0,14" Background="Transparent"
                         BorderThickness="0" Foreground="White" SelectionChanged="TraceList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#182321" CornerRadius="9" Padding="12,9" Margin="0,0,0,7">
                                <DockPanel>
                                    <TextBlock Text="{Binding Principle}" Foreground="#E8734A" FontWeight="Bold"
                                               DockPanel.Dock="Right" Margin="10,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Action}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Location}" Foreground="#82928E" FontFamily="Consolas" FontSize="10" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="0,5,0,12">
                    <TextBlock x:Name="TraceLocation" Text="Оберіть дію" Foreground="White" FontFamily="Consolas"
                               FontSize="13" FontWeight="Bold" />
                    <TextBlock x:Name="TraceExplanation" Text="Тут з'явиться пояснення принципу SOLID."
                               Foreground="#AAB5B2" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <Border Grid.Row="3" Background="#0A0F0E" BorderBrush="#26312F" BorderThickness="1" CornerRadius="12" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="CodePreview" Text="// Виконайте дію, щоб побачити код"
                                   Foreground="#D5DED9" FontFamily="Consolas" FontSize="12.5" LineHeight="21" TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
